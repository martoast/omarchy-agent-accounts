#!/bin/bash
# Start codex as the account selected in the bar widget.
#
# This shadows the real `codex` on PATH. It only chooses an account and hands
# off — every argument, exit code and stream belongs to the real CLI.

set -euo pipefail

# `codex --account 2` (or `--account=2`, `--account account2`) picks an
# account explicitly, exactly like `codex2`. The flag is ours, not the CLI's,
# so strip it before anything reaches the real binary. An explicit choice wins
# over both the widget selection and a nested-call stay-put.
account=""
args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --account)
      [[ $# -ge 2 ]] || { echo "codex: --account needs a value (1, 2, account2, …)" >&2; exit 2; }
      account=$2; shift 2 ;;
    --account=*)
      account=${1#--account=}; shift ;;
    *)
      args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"
if [[ -n $account ]]; then
  exec codex-profile run "$account" "$@"
fi

# Already inside an account: a nested call (the agent running a command that
# invokes it again) must stay on the account that started it, not jump to
# whatever the widget is showing now.
if [[ -n ${CODEX_ACCOUNT:-} || -n ${CODEX_HOME:-} ]]; then
  exec codex-real "$@"
fi

# Anything unexpected here would strand the user without a CLI, so a broken
# selection falls back to account1 rather than failing.
account=$(codex-profile selected 2>/dev/null || echo account1)
# agent-bridge is optional: machines without it run the account directly.
launch_root="$HOME/mcp-servers/agent-bridge/launch-root.mjs"
if [[ -f $launch_root ]] && command -v node >/dev/null; then
  exec node "$launch_root" codex-main codex -- codex-profile run "$account" "$@"
fi
exec codex-profile run "$account" "$@"
